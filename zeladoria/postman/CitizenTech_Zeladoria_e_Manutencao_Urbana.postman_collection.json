      "item": [
        {
          "name": "01 - Criar outra ocorrência para arquivar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ocorrencias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ocorrencias"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dados\": {\n    \"bairroId\": {{bairroId}},\n    \"categoriaId\": {{categoriaId}},\n    \"descricao\": \"Teste Postman - registro destinado a arquivamento\",\n    \"latitude\": -23.5501,\n    \"longitude\": -46.6301,\n    \"bloqueioTotal\": true,\n    \"proximoHospital\": true,\n    \"proximoEscola\": false\n  },\n  \"relato\": {\n    \"cidadaoId\": {{cidadaoId}},\n    \"descricao\": \"Registro fictício para testar o ciclo de manutenção\",\n    \"fotoUrl\": \"https://example.org/foto-local.jpg\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"ocorrenciaArquivarId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const resposta = pm.response.json();",
                  "  const id = resposta.ocorrencia.id;",
                  "  pm.test(\"ID válido\", function () { pm.expect(id).to.be.a(\"number\").above(0); });",
                  "  if (Number.isInteger(id) && id > 0) pm.collectionVariables.set(\"ocorrenciaArquivarId\", String(id));",
                  "}"
                ]
              }
            }
          ]
