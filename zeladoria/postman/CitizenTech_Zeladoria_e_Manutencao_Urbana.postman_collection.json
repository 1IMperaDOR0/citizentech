      "type": "string"
    },
    {
      "key": "senhaGestor",
      "value": "",
      "type": "string"
    },
    {
      "key": "bairroId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoriaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "cidadaoId",
      "value": "1",
