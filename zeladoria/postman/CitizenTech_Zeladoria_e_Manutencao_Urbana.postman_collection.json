    {
      "name": "02 - Ciclo completo de manutenção",
      "description": "Executar em ordem. Usa autenticação de gestor herdada da coleção. Os retornos 409 das tentativas inválidas são esperados e têm testes próprios. Para repetir o fluxo, comece novamente pela criação de ocorrência.",
      "item": [
        {
          "name": "01 - Criar ocorrência e salvar ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ocorrencias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ocorrencias"
              ]
            },
            "description": "Cria um novo registro de teste. Captura resposta.ocorrencia.id em ocorrenciaId; as chamadas seguintes usam esse ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dados\": {\n    \"bairroId\": {{bairroId}},\n    \"categoriaId\": {{categoriaId}},\n    \"descricao\": \"Teste Postman - calçada com passagem bloqueada\",\n    \"latitude\": -23.5501,\n    \"longitude\": -46.6301,\n    \"bloqueioTotal\": true,\n    \"proximoHospital\": true,\n    \"proximoEscola\": false\n  },\n  \"relato\": {\n    \"cidadaoId\": {{cidadaoId}},\n    \"descricao\": \"Registro fictício para testar o ciclo de manutenção\",\n    \"fotoUrl\": \"https://example.org/foto-local.jpg\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"ocorrenciaId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const resposta = pm.response.json();",
                  "  const id = resposta.ocorrencia.id;",
                  "  pm.test(\"ID válido\", function () { pm.expect(id).to.be.a(\"number\").above(0); });",
                  "  if (Number.isInteger(id) && id > 0) pm.collectionVariables.set(\"ocorrenciaId\", String(id));",
                  "}"
                ]
              }
            }
          ]
        },
